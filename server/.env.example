# ─────────────────────────────────────────────────────────────────────────────
# Sentys — configuration du serveur (copier en server/.env, jamais committé)
# Politique : docs/securite/POLITIQUE-SECRETS.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Réseau ───────────────────────────────────────────────────────────────────
# Listener LAN : interface locale + appareils (Pi, ESP32). Filtrer au pare-feu.
HOST=0.0.0.0
PORT=4000
# Listener public (cible du tunnel Tailscale Funnel), lié à 127.0.0.1.
# Les routes des appareils n'y sont pas accessibles. Laisser vide = désactivé.
PUBLIC_PORT=4001
# Origines autorisées (CORS) : domaine Vercel + interface LAN, séparées par des virgules
ALLOWED_ORIGINS=https://sentys.vercel.app,https://192.168.0.47
# Reverse proxy de confiance (nginx et tunnel locaux)
TRUST_PROXY=loopback

# ── Base de données (rôle dédié, voir server/sql/roles.sql) ────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentys
DB_USER=sentys_app
DB_PASSWORD=

# ── Secrets ─────────────────────────────────────────────────────────────────
# Laisser vides : ils sont générés au premier démarrage et conservés dans
# ~/.sentys/secrets.json (droits 600, hors du dépôt). Les renseigner ici
# uniquement pour les gérer vous-même (openssl rand -base64 48).
# Les valeurs faibles ou déjà publiées sont refusées au démarrage.
# Poivre des mots de passe : NE PAS PERDRE (à sauvegarder), ne pas changer.
PASSWORD_PEPPER=
# Clé de signature ES256 des sessions (générée dans ~/.sentys/jwt-es256.pem si absent)
# JWT_PRIVATE_KEY_FILE=/home/sentys/.sentys/jwt-es256.pem
# Durées de session : jeton d'accès 15 min, rafraîchissement 7 j glissants / 30 j max
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_IDLE_DAYS=7
# REFRESH_TOKEN_ABSOLUTE_DAYS=30
# Dossier des secrets générés (à inclure dans les sauvegardes chiffrées)
# SENTYS_DATA_DIR=/home/sentys/.sentys

# ── Notifications push (web-push generate-vapid-keys) ─────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:admin@example.invalid

# ── Appareils ───────────────────────────────────────────────────────────────
# legacy = accepte temporairement les appareils sans jeton (migration uniquement)
DEVICE_AUTH=enforce
MAX_DEVICE_UPLOAD_MB=200

# ── Vidéo ───────────────────────────────────────────────────────────────────
HLS_DIR=../hls
RECORDINGS_DIR=../recordings
# ── Conservation (docs/conformite/REGISTRE-TRAITEMENTS.md) ─────────────────
# Images : 30 jours maximum (loi caméras), plafonné par le serveur.
# Les enregistrements « conservés comme preuve » (_preuves/) sont exclus de la purge.
RECORDINGS_RETENTION_DAYS=30
ALERTS_RETENTION_DAYS=90
MOTION_EVENTS_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
SESSIONS_RETENTION_DAYS=30
GO2RTC_BIN=go2rtc
RTSP_TRANSPORT=tcp

# ── Météo (optionnel, coordonnées approximatives de la commune) ─────────────────
# WEATHER_LAT=
# WEATHER_LON=
